# Assistant cloud : démonstration statistique fictive uniquement.
# Secrets côté serveur, jamais NEXT_PUBLIC_*. Aucun compte payant ni recharge automatique.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# true seulement après vérification du mode gratuit dans le compte Mistral.
ASSISTANT_FREE_PLAN_CONFIRMED=false
# Redis partagé dédié à Diabia (peut utiliser une offre gratuite).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secret aléatoire >= 32 caractères, partagé avec la passerelle d'authentification.
ASSISTANT_AUTH_SECRET=
# Limites RÉELLES du compte/modèle, non valeurs commerciales supposées.
# Réservation pessimiste de 4096 tokens par appel + marge de sécurité 20 % (sauf plafond de requêtes égal à 1).
# Si une dimension est annoncée illimitée, choisir un plafond interne conservateur.
MISTRAL_QUOTA_RPM=
MISTRAL_QUOTA_RPD=
MISTRAL_QUOTA_TPM=
MISTRAL_QUOTA_TPD=
