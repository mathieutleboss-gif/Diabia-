# Assistant cloud : démonstration statistique fictive uniquement.
# Secrets côté serveur, jamais NEXT_PUBLIC_*. Aucun compte payant ni recharge automatique.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# true seulement après vérification du mode gratuit dans le compte Groq.
ASSISTANT_FREE_PLAN_CONFIRMED=false
# Redis partagé dédié à Diabia (peut utiliser une offre gratuite).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secret aléatoire >= 32 caractères, partagé avec la passerelle d'authentification.
ASSISTANT_AUTH_SECRET=
# Limites RÉELLES du compte/modèle, non valeurs commerciales supposées.
# Réservation pessimiste de 4096 tokens par appel + marge de sécurité 20 % (sauf plafond de requêtes égal à 1).
# Si une dimension est annoncée illimitée, choisir un plafond interne conservateur.
GROQ_QUOTA_RPM=
GROQ_QUOTA_RPD=
GROQ_QUOTA_TPM=
GROQ_QUOTA_TPD=

# Comptes et données : variables du Worker Sites (pas NEXT_PUBLIC).
DIABIA_SUPABASE_URL=
DIABIA_SUPABASE_KEY=
# Origine publique des liens email (jamais localhost), à autoriser aussi dans Supabase Auth.
DIABIA_PUBLIC_APP_URL=https://diabia-demo.validpika65.chatgpt.site
# Laisser false sans validation du cadre médical et de tous les hébergeurs.
DIABIA_REMOTE_HEALTH_APPROVED=false
DIABIA_SYNC_TEST_ENABLED=true
# true seulement après déploiement/test de la fonction diabia-account-delete.
DIABIA_ACCOUNT_DELETE_ENABLED=false
# La clé administrative reste dans les secrets gérés par Supabase de l’Edge Function.
# Ne jamais mettre de service_role ou sb_secret dans les variables du Worker Sites.
